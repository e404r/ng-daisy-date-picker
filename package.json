{
  "name": "ng-daisy-workspace",
  "version": "0.0.0",
  "workspaces": [
    "projects/ng-daisy-date-picker"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build ng-daisy-date-picker",
    "build:demo": "ng build demo",
    "package:lib": "npm run build:lib && cd dist/ng-daisy-date-picker && npm pack",
    "publish:lib": "npm run build:lib && cd dist/ng-daisy-date-picker && npm publish --access public",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "author": "e404r (https://github.com/e404r)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e404r/ng-daisy-date-picker.git"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "date-fns": "^4.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "daisyui": "^5.7.50",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
